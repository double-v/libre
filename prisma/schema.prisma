generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  normalizedEmail   String    @unique @default("")
  emailVerified     DateTime?
  displayName       String
  // Pseudo retiré par la règle (#459) : à choisir avant de continuer.
  mustRenameDisplayName Boolean @default(false)
  passwordHash      String?
  deviceId          String?
  role              String    @default("USER")
  createdAt         DateTime  @default(now())
  isVerified        Boolean   @default(false)
  isBanned          Boolean   @default(false)
  /// Mise en retrait (spec 006) : posée par la décision « vérification »,
  /// levée par le badge selfie. Privée — jamais lue par autrui.
  retraitAt         DateTime?
  squareBannedUntil DateTime? @map("square_banned_until")
  lastActive        DateTime  @updatedAt
  skin              String? // Skin choisi par l'utilisateur (cf. #224). null = défaut du site / localStorage.

  profile              Profile?
  profileAnswers       ProfileAnswer[]
  profileSignals       ProfileSignal[]
  userKey              UserKey?
  userKeyHistory       UserKeyHistory[]
  sentLikes            Like[]                @relation("SentLikes")
  receivedLikes        Like[]                @relation("ReceivedLikes")
  matchesAsA           Match[]               @relation("UserAMatches")
  matchesAsB           Match[]               @relation("UserBMatches")
  conversationsAsA     Conversation[]        @relation("UserAConversations")
  conversationsAsB     Conversation[]        @relation("UserBConversations")
  sentMessages         Message[]             @relation("SentMessages")
  encountersAsA        Encounter[]           @relation("UserAEncounters")
  encountersAsB        Encounter[]           @relation("UserBEncounters")
  reportsMade          Report[]              @relation("ReportsMade")
  reportsReceived      Report[]              @relation("ReportsReceived")
  verificationRequests VerificationRequest[] @relation("UserVerifications")
  verificationReviews  VerificationRequest[] @relation("ReviewerVerifications")
  blocksMade           Block[]               @relation("BlocksMade")
  blocksReceived       Block[]               @relation("BlocksReceived")
  reportReviews        Report[]              @relation("ReportReviewer")
  feedback             Feedback[]
  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  moderationActions    ModerationLog[]       @relation("ModerationActions")
  moderationTargets    ModerationLog[]       @relation("ModerationTargets")
  journalPosts         JournalPost[]         @relation("JournalPostAuteur")
  consents             Consent[]
  squareReports        SquareMessageReport[] @relation("SquareReportsMade")

  trustLevel         TrustLevel?
  trustContactsOwned TrustContact[]    @relation("TrustContactOwner")
  siteConfigsUpdated SiteConfig[]      @relation("SiteConfigUpdatedBy")
  trustContactsOf    TrustContact[]    @relation("TrustContactTarget")
  safetyCheckins     SafetyCheckin[]
  squareReactions    SquareReaction[]  @relation("SquareReactionsMade")
  photoModerations   PhotoModeration[] @relation("PhotoModerationOwner")
  pushSubscriptions  PushSubscription[] @relation("PushSubscriptions")

  @@index([isBanned, lastActive])
  @@map("users")
}

model Profile {
  userId                String    @id @db.Uuid
  bio                   String    @default("")
  birthDate             DateTime?
  genderIdentity        String    @default("")
  orientation           String[]
  relationshipType      String[]
  interests             String[]
  practices             String[]  @default([])
  // Qui voit `practices` : 'matches' (défaut) ou 'public' (#328). Le champ
  // était renvoyé à tout compte connecté alors que /profil promettait
  // l'inverse ; la promesse devient la valeur par défaut.
  practicesVisibility   String    @default("matches")
  /// Jusqu'où ce lecteur accepte de voir les photos classées sensibles (#331) :
  /// 'none' (défaut) | 'suggestive' | 'explicit'. Attribut du LECTEUR, pas de
  /// la photo — fermé par défaut, y compris pour les comptes existants.
  photoSensitivityOptIn String    @default("none")
  socialLinks           Json      @default("{}")
  photos                String[]
  maxDistanceKm         Int       @default(50)
  ageMin                Int       @default(18)
  ageMax                Int       @default(99)
  // Préférences de recherche (qui je veux voir), distinctes de l'identité
  // ci-dessus (qui je suis). Partagées entre /discover et /profil comme
  // source unique (#235). Vide = aucune restriction sur ce critère.
  searchGenders         String[]  @default([])
  searchOrientations    String[]  @default([])
  searchInterests       String[]  @default([])
  searchRelationshipTypes String[] @default([])
  // Parcours d'accueil (spec 005) : prochaine étape à montrer — 0 photo,
  // 1 ce que je cherche, 2 où, 3 terminé ou entièrement passé. Monotone :
  // le serveur garde le max. Privé : lu par la membre seule, jamais sérialisé
  // vers autrui (garde `onboarding-step-never-leaks.test.ts`).
  onboardingStep        Int       @default(0)
  // Filtre de distance du feed (#327). NULL = « partout » : volontairement
  // distinct de `maxDistanceKm` (rayon historique du segment « À proximité »,
  // qui vaut 50 chez tout le monde par défaut). Réutiliser `maxDistanceKm`
  // aurait silencieusement rétréci le feed « Pour toi » de tous les comptes
  // existants dès la mise en ligne du filtre.
  searchDistanceKm      Int?
  invisibleMode         Boolean   @default(false)
  lastKnownLat          Float     @default(0) @map("last_known_lat")
  lastKnownLng          Float     @default(0) @map("last_known_lng")
  lastGeolocAt          DateTime? @map("last_geoloc_at")
  // Repli « ville saisie à la main » (#402). Privés : lus par la membre seule,
  // jamais sélectionnés dans une réponse destinée à autrui (garde
  // `city-label-never-leaks.test.ts`). `positionSource` : 'device' | 'city' |
  // null ; un profil d'avant la feature avec une position se lit 'device'.
  positionSource        String?   @map("position_source")
  cityLabel             String?   @map("city_label")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Le filtre de distance (#327) pousse une bounding box lat/lng dans le WHERE :
  // sans index, chaque page de feed refait un seq scan de la table profils.
  @@index([lastKnownLat, lastKnownLng])
  @@map("profiles")
}

/// Réponse d'un membre à une question de la banque (spec 009). La banque vit
/// dans le code (`src/lib/questions.ts`) : `questionKey` et les clés de
/// `choices` en sont des clés stables. Une réponse par question, sans limite
/// de nombre. `status` : `published` ou `removed` (modération, US3) — une
/// réponse retirée n'est jamais envoyée à autrui et ne lève aucun voile.
model ProfileAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  questionKey String
  choices     String[] @default([])
  text        String   @default("")
  status      String   @default("published")
  /// Ce que la modération a retiré (revue PR #466) : une republication à
  /// l'identique est refusée, une réécriture est signalée à l'admin.
  removedText    String?
  removedChoices String[] @default([])
  removedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId])
  @@map("profile_answers")
}

/// Indice de faux profil (spec 006). Jamais lu par une route destinée aux
/// membres ; part avec le compte.
model ProfileSignal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  /// contact_pseudo · contact_bio · contact_photo · photo_reutilisee ·
  /// photo_bannie · photo_recuperee · signalement_faux
  type        String
  /// faible · fort
  force       String
  /// Le passage repéré (≤ 200), jamais la bio entière.
  extrait     String?
  photoKey    String?
  /// Sans clé étrangère : le lien survit à la suppression de l'autre compte.
  autreUserId String?  @db.Uuid
  /// Déduplication : le même signal sur le même contenu ne rouvre pas un
  /// dossier tranché (FR-016).
  cle         String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cle])
  @@index([createdAt])
  @@map("profile_signals")
}

model SiteConfig {
  id            String   @id @default("singleton")
  // ⚠️ Pas de @map ici : les colonnes physiques sont en camelCase
  // (currentTheme, updatedAt, updatedBy), telles que créées par la migration
  // add_site_config. Les @map("current_theme")… précédents faisaient
  // interroger des colonnes inexistantes → feature « thème de site » cassée
  // en prod, masquée par les fallbacks try/catch. Colonne = nom du champ.
  currentTheme  String   @default("default")
  // Fonctionnalités coupées depuis l'admin (#418) : `checkin`, `crossings`,
  // `square`. Vide = tout activé. Liste de ce qui est coupé, pas de ce qui est
  // actif : une fonctionnalité future est active sans migration de données.
  featuresDisabled String[] @default([])
  // Fonctionnalités **coupées par défaut** et allumées depuis l'admin (spec 007,
  // R4) : `journal_comments`. `featuresDisabled` ne sait pas dire « coupé tant
  // qu'on ne l'allume pas » — son vide vaut « tout activé ». Vide ici = tout ce
  // qui est coupé par défaut le reste.
  featuresEnabled  String[] @default([])
  updatedAt     DateTime @updatedAt
  updatedBy     String?  @db.Uuid
  updatedByUser User?    @relation("SiteConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("site_config")
}

model UserKey {
  userId       String   @id @db.Uuid
  publicKey    String
  keyCreatedAt DateTime @default(now())

  // Escrow (#198) : la clé privée d'identité, scellée par la clé maître serveur
  // (`CHAT_ESCROW_KEY`, cf. src/lib/crypto-escrow.ts). Jamais en clair ici.
  // Nullable, et sans backfill possible : le serveur n'a jamais vu la clé privée
  // des comptes d'avant la mise en service. C'est la migration douce (#336) qui
  // la remonte depuis l'appareil qui la détient encore.
  encryptedPrivateKey String?
  escrowedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_keys")
}

// Clés publiques remplacées par une réinitialisation (#340). Le pair s'en sert
// pour relire ce qu'il avait chiffré pour l'ancienne clé : sans cette trace, une
// réinitialisation d'un côté rendrait l'historique illisible des deux côtés.
// Une clé publique n'est pas un secret ; on ne garde jamais rien de privé ici.
model UserKeyHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  publicKey  String
  createdAt  DateTime
  replacedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_key_history")
}

model Encounter {
  id         String   @id @default(uuid()) @db.Uuid
  userA      String   @db.Uuid
  userB      String   @db.Uuid
  latitude   Float
  longitude  Float
  distanceM  Int
  happenedAt DateTime @default(now())

  userARel User @relation("UserAEncounters", fields: [userA], references: [id], onDelete: Cascade)
  userBRel User @relation("UserBEncounters", fields: [userB], references: [id], onDelete: Cascade)

  @@index([happenedAt])
  @@index([latitude, longitude])
  @@map("encounters")
}

model Like {
  likerId   String   @db.Uuid
  likedId   String   @db.Uuid
  createdAt DateTime @default(now())

  liker User @relation("SentLikes", fields: [likerId], references: [id], onDelete: Cascade)
  liked User @relation("ReceivedLikes", fields: [likedId], references: [id], onDelete: Cascade)

  @@id([likerId, likedId])
  @@map("likes")
}

model Match {
  id        String   @id @default(uuid()) @db.Uuid
  userA     String   @db.Uuid
  userB     String   @db.Uuid
  createdAt DateTime @default(now())

  userARel     User          @relation("UserAMatches", fields: [userA], references: [id], onDelete: Cascade)
  userBRel     User          @relation("UserBMatches", fields: [userB], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userA, userB])
  @@map("matches")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @unique @db.Uuid
  userA     String   @db.Uuid
  userB     String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userARel User      @relation("UserAConversations", fields: [userA], references: [id], onDelete: Cascade)
  userBRel User      @relation("UserBConversations", fields: [userB], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  content        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Report {
  id          String    @id @default(uuid()) @db.Uuid
  reporterId  String    @db.Uuid
  reportedId  String    @db.Uuid
  reason      String
  description String    @default("")
  status      String    @default("pending")
  reviewedBy  String?   @db.Uuid
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  /// Réponses publiées du profil signalé, copiées au signalement (spec 009) :
  /// la preuve ne s'efface pas si la personne modifie ou supprime ensuite.
  answersSnapshot Json?

  reporter User  @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User  @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReportReviewer", fields: [reviewedBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}

model VerificationRequest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  selfieUrl  String
  /// Code du geste tiré par le serveur (#436, src/lib/verification/gestes.ts).
  challenge    String?
  status     String    @default("pending")
  /// Motif de refus lu par le membre, code fermé (src/lib/verification/motifs.ts).
  rejectReason String?
  reviewedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user     User  @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewerVerifications", fields: [reviewedBy], references: [id], onDelete: Cascade)

  @@map("verification_requests")
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  category  String   @default("bug")
  message   String
  url       String?
  userAgent String?
  status    String   @default("open")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

model ModerationLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      String   @db.Uuid
  targetUserId String   @db.Uuid
  action       String
  reason       String?
  createdAt    DateTime @default(now())

  admin      User @relation("ModerationActions", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser User @relation("ModerationTargets", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([createdAt])
  @@map("moderation_logs")
}

model SquareMessage {
  id            String  @id @default(uuid()) @db.Uuid
  pseudonym     String
  content       String
  type          String
  isAdmin       Boolean @default(false)
  isSystem      Boolean @default(false)
  themeConfigId String? @db.Uuid

  // When set, the message is a GIF (rendered as <img> in the feed). The URL
  // must point to media[0-9]?.giphy.com (validated server-side). Mutually exclusive
  // with rich text in V1.
  gifUrl    String?  @map("gif_url")
  createdAt DateTime @default(now())

  themeConfig SquareThemeConfig?    @relation(fields: [themeConfigId], references: [id])
  reactions   SquareReaction[]
  reports     SquareMessageReport[]

  @@index([createdAt])
  @@map("square_messages")
}

/// État singleton de La Place (#13) — le reset quotidien ne dépend plus d'un
/// cron : c'est le premier passage HTTP après l'heure de reset qui l'exécute.
/// Cette ligne est le témoin qui empêche les suivants de le refaire.
// Témoin de la purge de rétention (#427) : un singleton, comme SquareState.
// `lastRunAt` sert de verrou (UPDATE … WHERE lastRunAt < borne), `lastReport`
// garde le bilan du dernier passage pour la page admin.
model RetentionState {
  id         String   @id @default("singleton")
  lastRunAt  DateTime @map("last_run_at")
  lastReport Json?    @map("last_report")

  @@map("retention_state")
}

model SquareState {
  id String @id @default("singleton")
  /// Borne du dernier reset appliqué (heure UTC pile, cf. `reset-clock.ts`) —
  /// pas l'instant d'exécution : deux instances qui traitent la même journée
  /// écrivent la même valeur, donc la réclamation reste idempotente.
  lastResetAt DateTime @map("last_reset_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("square_state")
}

model SquareThemeConfig {
  id             String   @id @default(uuid()) @db.Uuid
  themeId        String   @unique
  label          String
  description    String
  inputType      String
  placeholder    String
  maxLength      Int      @default(200)
  allowFreeText  Boolean  @default(false)
  options        Json?
  pseudonymNames Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  scheduleSlots SquareThemeSchedule[]
  messages      SquareMessage[]

  @@map("square_theme_configs")
}

model SquareThemeSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  dayOfWeek     Int      @unique
  themeConfigId String   @db.Uuid
  createdAt     DateTime @default(now())

  themeConfig SquareThemeConfig @relation(fields: [themeConfigId], references: [id], onDelete: Cascade)

  @@map("square_theme_schedule")
}

model BannedWord {
  id        String   @id @default(uuid()) @db.Uuid
  word      String   @unique
  severity  String   @default("block")
  createdAt DateTime @default(now())

  @@map("banned_words")
}

model SquareReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message SquareMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation("SquareReactionsMade", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji, userId])
  @@map("square_reactions")
}

model SquareMessageReport {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @db.Uuid
  reporterId String   @db.Uuid
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  message  SquareMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User          @relation("SquareReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("square_message_reports")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

/// Consent traceability — RGPD art. 7(1): "Where processing is based on consent, the controller shall be able to demonstrate that the data subject has consented"
model Consent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  type        String // "cgu", "privacy_policy", "cookies_essential", "cookies_analytics", "e2e_messaging", "geolocation", "feedback_tracking"
  version     String    @default("1") // version of the document/policy accepted
  given       Boolean   @default(true)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  withdrawnAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([createdAt])
  @@map("consents")
}

/// Trust circle — sécurité relationnelle.
/// V1 = Libre-only (cf. decision #43, roadmap/chantiers/01-securite).
/// V2 ajoutera contacts hors-app via flow d'invitation opt-in.
model TrustLevel {
  userId         String   @id @db.Uuid
  score          Int      @default(0)
  band           String   @default("newcomer") // newcomer | member | trusted | anchor
  factors        Json     @default("{}")
  lastComputedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([band])
  @@map("trust_levels")
}

model TrustContact {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  contactId String   @db.Uuid
  createdAt DateTime @default(now())

  owner   User @relation("TrustContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("TrustContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@index([ownerId])
  @@index([contactId])
  @@map("trust_contacts")
}

model SafetyCheckin {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  status      String    @default("active") // active | validated | expired | cancelled
  triggeredAt DateTime  @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?
  lastLat     Float?    @map("last_lat")
  lastLng     Float?    @map("last_lng")
  notes       String?   @db.Text

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts CheckinAlert[]

  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("safety_checkins")
}

model CheckinAlert {
  id             String   @id @default(uuid()) @db.Uuid
  checkinId      String   @db.Uuid
  contactId      String   @db.Uuid
  deliveryStatus String   @default("queued") // queued | sent | failed | handled
  sentAt         DateTime @default(now())

  checkin SafetyCheckin @relation(fields: [checkinId], references: [id], onDelete: Cascade)

  @@index([checkinId])
  @@index([contactId])
  @@map("checkin_alerts")
}

/// Classification de sensibilité d'une photo (#330).
///
/// Indexée par la **clé R2**, pas par un index dans `Profile.photos` : la clé
/// est unique et stable (`crypto.randomUUID()` à l'upload), donc la
/// classification survit au réordonnancement et au retrait d'une autre photo.
/// Un tableau parallèle aurait perdu la classification en silence dès le
/// premier retrait.
///
/// L'absence de ligne vaut « ordinaire » : rien à rétro-remplir, et le défaut
/// est exactement le comportement d'avant la feature.
model PhotoModeration {
  key          String   @id
  ownerId      String   @db.Uuid
  /// 'suggestive' | 'explicit' — cf. src/lib/photo-sensitivity.ts
  sensitivity  String
  /// Clé R2 du dérivé flouté servi aux comptes non consentants.
  blurredKey   String
  /// NULL = auto-déclaration par le propriétaire ; sinon l'admin qui a classé.
  classifiedBy String?  @db.Uuid
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User @relation("PhotoModerationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("photo_moderation")
}

/// Abonnement Web Push d'UN appareil (#392, spec 003). La table ne sert qu'à
/// savoir OÙ envoyer : ni contenu, ni historique, ni compteur. Cascade sur la
/// suppression du compte (FR-022). Pas de @map de colonne, comme le reste du
/// schéma (leçon siteconfig-map-drift).
model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  /// Dernier envoi réussi — best-effort, pour un futur ménage.
  lastUsedAt DateTime?

  user User @relation("PushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Publication du journal « Où en est Libre » (spec 007, #351).
///
/// Publique une fois `publiee` : tout ce qui est écrit ici part sur une page
/// indexée d'un projet open source — d'où les garde-fous éditoriaux
/// (`src/lib/journal/garde-fous.ts`) recontrôlés par le serveur à chaque
/// publication. `auteurId` n'est jamais affiché (« L'équipe Libre »).
model JournalPost {
  id           String    @id @default(uuid()) @db.Uuid
  /// Fixé à la première publication, jamais modifié ensuite : une adresse
  /// partagée ne doit pas casser. `null` tant que jamais publiée.
  slug         String?   @unique
  titre        String
  corps        String
  /// `brouillon` | `publiee`. Dépublier ramène à `brouillon`.
  statut       String    @default("brouillon")
  /// Première publication, conservée par les republications.
  publieeAt    DateTime?
  modifieeAt   DateTime  @updatedAt
  createdAt    DateTime  @default(now())
  auteurId     String?   @db.Uuid
  auteur       User?     @relation("JournalPostAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  /// Préparation de #352 : sans interface au MVP, fermé par défaut. Les
  /// commentaires exigeront aussi l'interrupteur global `journal_comments`.
  commentsOpen Boolean   @default(false)

  @@index([statut, publieeAt(sort: Desc)])
  @@map("journal_posts")
}
